<Project>
  <PropertyGroup>
    <_IngaCookBookBuildProject>$(MSBuildThisFileDirectory)IngaCookBook.Build/IngaCookBook.Build.csproj</_IngaCookBookBuildProject>
    <_IngaCookBookBuildAssembly>$(MSBuildThisFileDirectory)IngaCookBook.Build/bin/$(Configuration)/net10.0/IngaCookBook.Build.dll</_IngaCookBookBuildAssembly>
    <_IngaCookBookDotNetHost Condition="'$(DotNetHostPath)' != ''">$(DotNetHostPath)</_IngaCookBookDotNetHost>
    <_IngaCookBookDotNetHost Condition="'$(_IngaCookBookDotNetHost)' == ''">dotnet</_IngaCookBookDotNetHost>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(_IngaCookBookBuildProject)"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      PrivateAssets="all"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishAot;PublishTrimmed" />
  </ItemGroup>

  <!-- Always recheck, including incremental builds and deleted companion files. -->
  <Target Name="ValidateRazorCodeBehind"
          BeforeTargets="CoreCompile"
          DependsOnTargets="ResolveProjectReferences;ResolveRazorComponentInputs"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_IngaCookBookComponentManifest>$(IntermediateOutputPath)ingacookbook-razor-components.txt</_IngaCookBookComponentManifest>
      <_IngaCookBookCompileManifest>$(IntermediateOutputPath)ingacookbook-compile-files.txt</_IngaCookBookCompileManifest>
    </PropertyGroup>
    <WriteLinesToFile File="$(_IngaCookBookComponentManifest)" Lines="@(RazorComponent->'%(FullPath)')"
                      Overwrite="true" WriteOnlyWhenDifferent="true" Encoding="UTF-8" />
    <WriteLinesToFile File="$(_IngaCookBookCompileManifest)" Lines="@(Compile->'%(FullPath)')"
                      Overwrite="true" WriteOnlyWhenDifferent="true" Encoding="UTF-8" />
    <ItemGroup>
      <FileWrites Include="$(_IngaCookBookComponentManifest);$(_IngaCookBookCompileManifest)" />
    </ItemGroup>
    <!-- A separate process avoids locking the validator's assemblies in reusable MSBuild nodes. -->
    <Exec Command="&quot;$(_IngaCookBookDotNetHost)&quot; &quot;$(_IngaCookBookBuildAssembly)&quot; &quot;$(MSBuildProjectDirectory)&quot; &quot;$(RootNamespace)&quot; &quot;$(DefineConstants)&quot; &quot;$(_IngaCookBookComponentManifest)&quot; &quot;$(_IngaCookBookCompileManifest)&quot;"
          Condition="'@(RazorComponent)' != ''" />
  </Target>
</Project>
