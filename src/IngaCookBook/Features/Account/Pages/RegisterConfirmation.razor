@page "/Account/RegisterConfirmation"

@using Microsoft.AspNetCore.Identity
@using IngaCookBook.Data

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Register confirmation</PageTitle>

<h1>Register confirmation</h1>

<StatusMessage Message="@_statusMessage" />

@if (EmailOptions.Value.Enabled)
{
    <p role="alert">Please check your email to confirm your account.</p>
}
else
{
    <p>Email confirmation is not required. <a href="Account/Login">Log in</a> with your password or passkey.</p>
}
