<script type="module" src="@Assets["Components/Layout/ReconnectModal.razor.js"]"></script>

<section id="components-session-recovery" class="notice session-recovery" data-kind="warning" data-permanent hidden aria-label="Session recovery">
    <p role="status">This session has ended. Copy any unsaved inputs, then refresh to reconnect.</p>
    <button type="button" id="components-session-refresh-button" class="native-button">Refresh app</button>
</section>

<dialog id="components-reconnect-modal" aria-label="Server connection" data-nosnippet>
    <FluentStack Orientation="Orientation.Vertical" VerticalGap="var(--spacingVerticalL)" Class="components-reconnect-container">
        <p class="components-reconnect-first-attempt-visible">
            Rejoining the server...
        </p>
        <p class="components-reconnect-repeated-attempt-visible">
            Rejoin failed... trying again in <span id="components-seconds-to-next-attempt"></span> seconds.
        </p>
        <p class="components-reconnect-failed-visible">
            Failed to rejoin.<br />Please retry or reload the page.
        </p>
        <button type="button" id="components-reconnect-button" class="native-button components-reconnect-failed-visible">
            Retry
        </button>
        <p class="components-pause-visible">
            The session has been paused by the server.
        </p>
        <p class="components-resume-failed-visible">
            Failed to resume the session.<br />Please retry or reload the page.
        </p>
        <button type="button" id="components-resume-button" class="native-button components-pause-visible components-resume-failed-visible">
            Resume
        </button>
        <p class="components-reconnect-rejected-visible">
            This session has ended. Refresh to reconnect. Unsaved changes cannot be saved to this session;
            review and copy any inputs you want to keep before refreshing.
        </p>
        <button type="button" id="components-review-inputs-button" class="native-button components-reconnect-rejected-visible">
            Review my inputs
        </button>
        <button type="button" id="components-reload-button" class="native-button components-reconnect-rejected-visible">
            Refresh app
        </button>
    </FluentStack>
</dialog>
