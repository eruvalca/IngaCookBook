@inherits LayoutComponentBase

<a class="skip-link" href="@MainContentUrl" data-enhance-nav="false">Skip to content</a>

<div class="page">
    <FluentLayout Id="app-layout" Class="app-layout" GlobalScrollbar="true" Height="auto">
        <FluentLayoutItem Area="LayoutArea.Header" Class="site-header-area" Padding="0" Height="64px">
            <header class="site-header">
                <FluentStack VerticalAlignment="VerticalAlignment.Center" HorizontalGap="var(--spacingHorizontalM)" Height="100%" Width="100%">
                    <div class="menu-toggle">
                        <FluentLayoutHamburger Id="site-menu" PanelHeader="IngaCookBook" />
                    </div>
                    <a class="site-name" href="/" aria-label="IngaCookBook">Inga’s <span>recipe notebook</span></a>
                    <span class="site-tagline">A little better, every batch.</span>
                </FluentStack>
            </header>
        </FluentLayoutItem>
        <FluentLayoutItem Area="LayoutArea.Navigation" Class="site-navigation">
            <NavMenu />
        </FluentLayoutItem>
        <FluentLayoutItem Area="LayoutArea.Content" Class="site-content-area">
            <main id="main-content" class="content-container" tabindex="-1">
                @Body
            </main>
        </FluentLayoutItem>
        <FluentLayoutItem Area="LayoutArea.Footer">
            <footer class="site-footer">Made with curiosity. Kept with care.</footer>
        </FluentLayoutItem>
    </FluentLayout>
</div>

<div id="blazor-error-ui" data-nosnippet>
    <FluentStack Class="error-content" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="var(--spacingHorizontalL)" Wrap="true">
        <span>An unhandled error has occurred.</span>
        <a href="." class="reload">Reload</a>
        <button type="button" class="dismiss">Dismiss</button>
    </FluentStack>
</div>
