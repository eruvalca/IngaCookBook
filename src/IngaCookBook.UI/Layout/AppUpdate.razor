<section id="app-update" class="notice app-update" data-kind="information" data-app-update hidden aria-label="Application update">
    <p role="status">A new version of Inga’s is ready. Save your changes, then refresh when you’re ready.</p>
    <FluentStack HorizontalGap="var(--spacingHorizontalM)" Wrap="true">
        <FluentButton Type="ButtonType.Button" Appearance="ButtonAppearance.Outline" role="button" data-update-refresh>Refresh app</FluentButton>
        <FluentButton Type="ButtonType.Button" Appearance="ButtonAppearance.Transparent" role="button" data-update-later>Later</FluentButton>
    </FluentStack>
</section>
