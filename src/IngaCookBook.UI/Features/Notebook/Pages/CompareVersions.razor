@page "/recipes/{RecipeId:guid}/compare"
@attribute [Authorize]
@inherits NotebookPage
@using IngaCookBook.UI.Features.Notebook.Models

<PageTitle>Compare versions · IngaCookBook</PageTitle>
<a class="back-link" href="@($"/recipes/{RecipeId}")">← Recipe history</a>
<p class="eyebrow">FOLLOW THE CHANGES</p><h1>What changed?</h1>
<SaveNotice Error="@Error" />
@if (_recipe is not null)
{
    <p class="lede">@_recipe.Name</p>
    @if (_right is not null) { <RecipeNavigation RecipeId="RecipeId" VersionId="_right.Id" Section="compare" /> }
    <details class="comparison-selectors"><summary>Choose versions to compare</summary><form method="get" class="notebook-panel">
        <FluentGrid Spacing="4">
            <FluentGridItem Xs="12" Sm="6"><div class="form-field"><label for="left-version">Starting version</label>
                <select id="left-version" name="left">@foreach (var version in _recipe.Versions) { <option value="@version.Id" selected="@(version.Id == _left?.Id)">V@(version.Number) · @version.Content.Label</option> }</select>
            </div></FluentGridItem>
            <FluentGridItem Xs="12" Sm="6"><div class="form-field"><label for="right-version">Compare with</label>
                <select id="right-version" name="right">@foreach (var version in _recipe.Versions) { <option value="@version.Id" selected="@(version.Id == _right?.Id)">V@(version.Number) · @version.Content.Label</option> }</select>
            </div></FluentGridItem>
        </FluentGrid>
        <p><button class="native-button" type="submit">Compare versions</button></p>
    </form></details>
    @if (_left is not null && _right is not null)
    {
        <section class="comparison-overview"><p class="eyebrow">V@(_left.Number) → V@(_right.Number)</p><h2>@_left.Content.Label → @_right.Content.Label</h2><p>@_changes.Count @(_changes.Count == 1 ? "formulation change" : "formulation changes") · selected tasting results below</p>
        <FluentStack Wrap="true" HorizontalGap="var(--spacingHorizontalM)">
            @foreach (var metric in ObservedMetrics) { var leftScore = _leftEvaluation?.Scores.FirstOrDefault(s => s.MetricId == metric.Id); var rightScore = _rightEvaluation?.Scores.FirstOrDefault(s => s.MetricId == metric.Id); if (leftScore?.Score is not null && rightScore?.Score is not null) { <span class="score-chip">@metric.Name <strong>@leftScore.Score → @rightScore.Score (@Delta(leftScore.Score, rightScore.Score))</strong></span> } }
        </FluentStack><p class="muted">These observations describe the selected tastings; they do not establish what caused a change.</p></section>
        <section class="notebook-panel">
            <h2>Ingredients &amp; preparation</h2>
            @if (_changes.Count == 0) { <p>No ingredient, preparation, or yield differences.</p> }
            else
            {
                <div class="table-container"><table><caption>Changes from V@(_left.Number) to V@(_right.Number)</caption><thead><tr><th scope="col">What changed</th><th scope="col">V@(_left.Number)</th><th scope="col">V@(_right.Number)</th></tr></thead>
                    <tbody>@foreach (var change in _changes) { <tr><th scope="row">@change.Label</th><td class="preserve-lines">@NotebookText.DifferenceValue(change.Before, change.Label)</td><td class="preserve-lines">@NotebookText.DifferenceValue(change.After, change.Label)</td></tr> }</tbody>
                </table></div>
            }
            <details><summary>Questions, notes &amp; related changes</summary><div class="table-container"><table><caption>Experiment context</caption><thead><tr><th>Context</th><th>V@(_left.Number)</th><th>V@(_right.Number)</th></tr></thead><tbody>
                <tr><th>Question</th><td>@_left.Content.Hypothesis</td><td>@_right.Content.Hypothesis</td></tr>
                <tr><th>Related changes</th><td>@_left.Content.RelatedChanges</td><td>@_right.Content.RelatedChanges</td></tr>
                <tr><th>Recipe notes</th><td>@_left.Content.Notes</td><td>@_right.Content.Notes</td></tr>
            </tbody></table></div></details>
        </section>
        <section class="notebook-panel">
            <h2>Tasting results</h2><p class="muted">Latest tastings are selected by default. Choose specific batches and tastings for a fair comparison. Blank means not scored.</p>
            <form method="get">
                <input type="hidden" name="left" value="@_left.Id" /><input type="hidden" name="right" value="@_right.Id" />
                <FluentGrid Spacing="4">
                    <FluentGridItem Xs="12" Sm="6"><div class="form-field"><label for="left-eval">V@(_left.Number) tasting</label><select id="left-eval" name="le"><option value="">Latest tasting</option>@foreach (var option in EvaluationOptions(_left)) { <option value="@option.Id" selected="@(option.Id == LeftEvaluation)">@option.Label</option> }</select></div></FluentGridItem>
                    <FluentGridItem Xs="12" Sm="6"><div class="form-field"><label for="right-eval">V@(_right.Number) tasting</label><select id="right-eval" name="re"><option value="">Latest tasting</option>@foreach (var option in EvaluationOptions(_right)) { <option value="@option.Id" selected="@(option.Id == RightEvaluation)">@option.Label</option> }</select></div></FluentGridItem>
                </FluentGrid>
                <p><button class="native-button" type="submit">Compare tastings</button></p>
            </form>
            <p>@EvaluationLabel(_left, _leftEvaluation) → @EvaluationLabel(_right, _rightEvaluation)</p>
            <div class="table-container"><table class="quality-scores"><caption>Quality scores (1–10)</caption><thead><tr><th>Metric</th><th>V@(_left.Number)</th><th>V@(_right.Number)</th><th>Change</th></tr></thead><tbody>
                @foreach (var metric in ObservedMetrics)
                {
                    var l = _leftEvaluation?.Scores.FirstOrDefault(s => s.MetricId == metric.Id);
                    var r = _rightEvaluation?.Scores.FirstOrDefault(s => s.MetricId == metric.Id);
                    <tr><th scope="row">@metric.Name</th><td><strong>@(l?.Score?.ToString() ?? "—")</strong><p>@l?.Notes</p></td><td><strong>@(r?.Score?.ToString() ?? "—")</strong><p>@r?.Notes</p></td><td>@Delta(l?.Score, r?.Score)</td></tr>
                }
            </tbody></table></div>
            @if (UnassessedMetrics.Any()) { <details><summary>@UnassessedMetrics.Count() unassessed qualities</summary><ul>@foreach (var metric in UnassessedMetrics) { <li>@metric.Name · not scored in either tasting</li> }</ul></details> }
            <FluentGrid Spacing="4"><FluentGridItem Xs="12" Sm="6"><h3>V@(_left.Number) observations</h3><p>@_leftEvaluation?.Notes</p><p><strong>Next idea:</strong> @_leftEvaluation?.NextIdea</p></FluentGridItem><FluentGridItem Xs="12" Sm="6"><h3>V@(_right.Number) observations</h3><p>@_rightEvaluation?.Notes</p><p><strong>Next idea:</strong> @_rightEvaluation?.NextIdea</p></FluentGridItem></FluentGrid>
        </section>
        <FluentGrid Spacing="4">
            @foreach (var version in new[] { _left, _right })
            {
                <FluentGridItem Xs="12" Sm="6"><details class="notebook-panel"><summary>V@(version.Number) photos · @version.Photos.Count</summary>
                    @foreach (var photo in version.Photos) { <img class="comparison-photo" src="@($"/api/notebook/recipes/{RecipeId}/versions/{version.Id}/photos/{photo.Id}")" alt="@photo.Caption" loading="lazy" /> }
                </details></FluentGridItem>
            }
        </FluentGrid>
    }
}
