@page "/recipes"
@attribute [Authorize]
@inherits NotebookPage

<PageTitle>Your recipes · IngaCookBook</PageTitle>
<p class="eyebrow">FROM YOUR KITCHEN</p>
<FluentStack HorizontalAlignment="HorizontalAlignment.SpaceBetween" VerticalAlignment="VerticalAlignment.Center" Wrap="true">
    <div><h1>Your recipes</h1><p class="lede">Small changes. Delicious discoveries.</p></div>
    <a class="action-link primary" href="/recipes/new">+ New recipe</a>
</FluentStack>
<SaveNotice Error="@Error" />
@if (_loaded && _workspace is null)
{
    <section class="empty-state"><h2>A place for your ideas</h2><p>Create your private workspace to start your recipe notebook.</p><a class="action-link primary" href="/workspace">Create workspace</a></section>
}
else if (_loaded)
{
    @if (RecentDraft is { } recent && string.IsNullOrWhiteSpace(Query) && string.IsNullOrWhiteSpace(StatusFilter))
    {
        <section class="resume-card"><FluentStack HorizontalAlignment="HorizontalAlignment.SpaceBetween" VerticalAlignment="VerticalAlignment.Center" Wrap="true">
            <div><p class="eyebrow">PICK UP WHERE YOU LEFT OFF</p><h2>@recent.Recipe.Name</h2><p class="muted">Draft V@(recent.Version.Number) · @recent.Version.Content.Label</p></div>
            <a class="action-link primary" href="@($"/recipes/{recent.Recipe.Id}/versions/{recent.Version.Id}/edit")">Continue editing</a>
        </FluentStack></section>
    }
    <form method="get" action="/recipes" class="library-search" role="search">
        <FluentStack VerticalAlignment="VerticalAlignment.Bottom" HorizontalGap="var(--spacingHorizontalM)" Wrap="true">
            <div class="form-field"><label for="recipe-search">Find a recipe</label><input id="recipe-search" name="q" type="search" value="@Query" placeholder="Vanilla, caramel, sourdough…" /></div>
            <div class="form-field"><label for="recipe-status">Show</label><select id="recipe-status" name="status"><option value="">All recipes</option><option value="drafts" selected="@(StatusFilter == "drafts")">With drafts</option><option value="tasting" selected="@(StatusFilter == "tasting")">Awaiting a tasting</option><option value="standards" selected="@(StatusFilter == "standards")">Standards</option></select></div><button class="native-button" type="submit">Search</button>
            <a href="/recipes">Clear</a>
        </FluentStack>
    </form>
    @if (!Filtered.Any())
    {
        <section class="empty-state"><span class="eyebrow">ROOM FOR SOMETHING GOOD</span><h2>@(_recipes.Count == 0 ? "Your first recipe starts here" : "No matching recipes")</h2><p>Capture your ingredients, make a batch, and let each tasting guide your next experiment.</p><a href="/recipes/new" class="action-link primary">Start a recipe</a></section>
    }
    <FluentGrid Spacing="5">
        @foreach (var recipe in Filtered)
        {
            <FluentGridItem Xs="12" Sm="6" Lg="4" @key="recipe.Id">
                <article class="recipe-card">
                    <div class="recipe-card-cover @(Cover(recipe) is null ? "without-photo" : "")">
                        @if (Cover(recipe) is { } cover)
                        {
                            <img src="@cover" alt="@recipe.Name" loading="lazy" />
                        }
                        else
                        {
                            <span class="eyebrow">YOUR RECIPE NOTEBOOK</span>
                        }
                    </div>
                    <div class="recipe-card-body">
                        <span class="badge @(recipe.StandardVersionId is null ? "" : "standard")">@(recipe.StandardVersionId is null ? "In development" : "Standard selected")</span>
                        <h2><a href="@($"/recipes/{recipe.Id}")">@recipe.Name</a></h2>
                        <p>@recipe.Description</p>
                        <p class="muted">@Count(recipe.Versions.Count, "version") · @Count(recipe.Versions.Sum(v => v.Batches.Count), "batch")</p>
                        @if (AwaitingTasting(recipe) is { } untasted) { <a class="action-link" href="@($"/recipes/{recipe.Id}/versions/{untasted.Id}/batches?mode=taste")">Add a tasting</a> }
                        else if (Draft(recipe) is { } draft) { <a class="action-link" href="@($"/recipes/{recipe.Id}/versions/{draft.Id}/edit")">Continue draft</a> }
                        else if (recipe.Versions.FirstOrDefault(v => v.Id == recipe.StandardVersionId) is { } standard) { <a class="action-link" href="@($"/recipes/{recipe.Id}/versions/{standard.Id}/batches?mode=make")">Make a batch</a> }
                    </div>
                </article>
            </FluentGridItem>
        }
    </FluentGrid>
}
else if (Error is null)
{
    <p role="status">Opening your notebook…</p>
}
