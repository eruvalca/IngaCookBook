@page "/workspace"
@attribute [Authorize]
@inherits NotebookPage

<PageTitle>Your workspace · IngaCookBook</PageTitle>
<p class="eyebrow">A PLACE TO CREATE</p>
<h1>@(_workspace?.Name ?? "Make yourself at home")</h1>
<SaveNotice Error="@Error" />
@if (_workspace is not null)
{
    <FluentCard Class="notebook-panel"><h2>Your kitchen notebook</h2><p>Recipes and experiments here belong to you.</p><p>Ingredient prices use @_workspace.Currency.</p><a href="/recipes" class="action-link primary">Open your recipe library</a></FluentCard>
}
else
{
    <p class="lede">Give your kitchen a name. This is your private space for recipes and experiments.</p>
    <EditForm Model="Input" FormName="workspace" method="post" Enhance OnValidSubmit="CreateAsync" class="account-form notebook-panel">
        <DataAnnotationsValidator /><ValidationSummary />
        <div class="form-field"><label for="workspace-name">Workspace name</label><InputText id="workspace-name" @bind-Value="Input.Name" maxlength="120" autocomplete="organization" /></div>
        <div class="form-field"><label for="workspace-currency">Currency for ingredient costs</label><InputSelect id="workspace-currency" @bind-Value="Input.Currency"><option>USD</option><option>CAD</option><option>GBP</option><option>EUR</option><option>AUD</option></InputSelect></div>
        <button type="submit">Create my workspace</button>
    </EditForm>
}
